{
  "name": "auto-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node scripts/setup-python.mjs",
    "dev": "npm-run-all --parallel --race dev:react dev:electron dev:flask",
    "dev:react": "vite --config frontend/vite.config.ts",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "dev:flask": "python backend/app.py",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "lint": "eslint .",
    "test:conflicts": "node scripts/test-conflicts-database.mjs",
    "test:conflicts:sample": "node scripts/test-conflicts.mjs",
    "preview": "vite preview --config frontend/vite.config.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "transpile:electron": "tsc --project frontend/src/desktop/tsconfig.json && tsc --project frontend/src/desktop/tsconfig.preload.json",
    "dist:mac": "npm run build:backend && npm run transpile:electron && npm run build && electron-builder --config frontend/electron-builder.json --mac --arm64",
    "dist:win": "npm run build:backend && npm run transpile:electron && npm run build && electron-builder --config frontend/electron-builder.json --win --x64",
    "dist:linux": "npm run build:backend && npm run transpile:electron && npm run build && electron-builder --config frontend/electron-builder.json --linux --x64"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^24.7.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
